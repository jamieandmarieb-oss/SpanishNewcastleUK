# Public HTTPS address of the deployed Node service, with no trailing slash.
BASE_URL=https://sml3004-lti.example.ac.uk

# Canvas LTI 1.3 Developer Key client ID. Add this after the Canvas administrator
# creates/enables the Developer Key from /canvas-config.json.
CANVAS_CLIENT_ID=10000000000001

# Canvas cloud production defaults. Change only for Canvas beta/test/self-hosted.
CANVAS_ISSUER=https://canvas.instructure.com
CANVAS_AUTH_URL=https://sso.canvaslms.com/api/lti/authorize_redirect
CANVAS_JWKS_URL=https://sso.canvaslms.com/api/lti/security/jwks

# Optional: restrict launches to one Canvas deployment ID after installation.
CANVAS_DEPLOYMENT_ID=

# Tool signing key. Generate locally with: npm run generate-keys
# Keep the private key OUT of GitHub and provide it to the host as a secret.
LTI_PRIVATE_KEY_PATH=./keys/private.pem
LTI_KEY_ID=sml3004-2026

PORT=3000
RECORDING_DIR=/tmp/sml3004-recordings
MAX_RECORDING_MB=500
